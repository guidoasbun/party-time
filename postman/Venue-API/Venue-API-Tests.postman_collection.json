				{
					"name": "Search Venues - Basic Query",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has results array\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('results');",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Response has total_results and query fields\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('total_results');",
									"    pm.expect(jsonData).to.have.property('query');",
									"});",
									"",
									"pm.test(\"Venues have required fields\", function () {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.results.length > 0) {",
									"        const venue = jsonData.results[0];",
									"        pm.expect(venue).to.have.property('place_id');",
									"        pm.expect(venue).to.have.property('name');",
									"        pm.expect(venue).to.have.property('address');",
									"        pm.expect(venue).to.have.property('location');",
									"        ",
									"        // Save first place_id for subsequent tests",
									"        pm.collectionVariables.set(\"search_place_id\", venue.place_id);",
									"        console.log('Found venue: ' + venue.name);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
