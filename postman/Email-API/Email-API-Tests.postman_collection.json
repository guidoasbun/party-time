{
	"info": {
		"_postman_id": "email-api-tests-2025",
		"name": "Email API Tests - Party-Time",
		"description": "Comprehensive testing suite for Party-Time Email Service API\n\nThis collection tests all email endpoints including:\n- Send operations (test emails, template emails)\n- Email logs retrieval with filtering\n- Email statistics and analytics\n- AWS SES management (verification, quota)\n\nTwo testing modes:\n1. **Local Mode** (Email-API-Local environment): Tests logs/stats without AWS SES\n2. **AWS Mode** (Email-API-AWS environment): Full testing with AWS SES credentials\n\nPrerequisites:\n- Backend server running on localhost:8000\n- PostgreSQL database running\n- Redis running (for Celery)\n- (Optional) AWS SES configured for send operations",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Setup & Health",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has status field\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData.status).to.eql('healthy');",
									"});",
									"",
									"pm.test(\"Response time is less than 500ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Basic health check to verify backend is running"
					},
					"response": []
				},
				{
					"name": "Check Email Service Config",
					"event": [
						{
