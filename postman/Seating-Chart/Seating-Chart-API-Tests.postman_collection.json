				{
					"name": "Get Guests - Auto-populate IDs",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Auto-populate guest IDs for testing\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('guests');",
									"    pm.expect(jsonData.guests).to.be.an('array');",
									"    ",
									"    // Save up to 5 guest IDs",
									"    if (jsonData.guests.length >= 1) {",
									"        pm.collectionVariables.set(\"guest_id\", jsonData.guests[0].id);",
									"    }",
									"    if (jsonData.guests.length >= 2) {",
									"        pm.collectionVariables.set(\"guest_id_2\", jsonData.guests[1].id);",
									"    }",
									"    if (jsonData.guests.length >= 3) {",
									"        pm.collectionVariables.set(\"guest_id_3\", jsonData.guests[2].id);",
									"    }",
									"    if (jsonData.guests.length >= 4) {",
									"        pm.collectionVariables.set(\"guest_id_4\", jsonData.guests[3].id);",
									"    }",
									"    if (jsonData.guests.length >= 5) {",
									"        pm.collectionVariables.set(\"guest_id_5\", jsonData.guests[4].id);",
									"    }",
									"    ",
									"    console.log('Auto-populated ' + Math.min(jsonData.guests.length, 5) + ' guest IDs');",
									"});",
									"",
									"pm.test(\"Event has at least 5 guests for auto-assign tests\", function () {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.guests.length < 5) {",
									"        console.warn('Warning: Event has only ' + jsonData.guests.length + ' guests. Auto-assign tests may fail if fewer than 3 guests exist.');",
									"    }",
									"    pm.expect(jsonData.guests.length).to.be.at.least(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/{{api_version}}/events/{{event_id}}/guests?limit=5",
							"host": ["{{base_url}}"],
							"path": ["{{api_version}}", "events", "{{event_id}}", "guests"],
							"query": [
								{
									"key": "limit",
									"value": "5"
								}
							]
						},
						"description": "Fetch the first 5 guests from the event and auto-populate guest_id variables for subsequent tests."
					},
					"response": []
				}
			],
