              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Birthday Party\",\n  \"description\": \"A fun birthday celebration for testing\",\n  \"type\": \"birthday\",\n  \"start_date\": \"2024-12-15T18:00:00\",\n  \"end_date\": \"2024-12-15T22:00:00\",\n  \"location\": \"123 Party Street, Test City\",\n  \"venue_name\": \"Test Party Hall\",\n  \"venue_address\": \"123 Party Street, Test City, TC 12345\",\n  \"max_guests\": 50,\n  \"budget_total\": 2500.00,\n  \"is_public\": false\n}"
