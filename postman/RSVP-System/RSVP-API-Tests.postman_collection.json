{
	"info": {
		"_postman_id": "rsvp-api-tests-001",
		"name": "RSVP API - Public Endpoints",
		"description": "Comprehensive test suite for Party-Time RSVP public API endpoints.\n\n## Overview\nThis collection tests all public RSVP endpoints that allow guests to respond to event invitations without authentication.\n\n## Features Tested\n- Token validation\n- Event details retrieval\n- RSVP submission (attending/not attending/maybe)\n- Preference updates (dietary restrictions, meal choices)\n- Plus-one management\n- Error handling (expired tokens, invalid tokens, rate limiting)\n\n## Setup\n1. Ensure backend server is running on http://localhost:8000\n2. Run the test data seed script: `python backend/scripts/seed_rsvp_test_data.py`\n3. Import the environment: `RSVP-API-Local.postman_environment.json`\n4. Run the collection with Collection Runner\n\n## Created\nPhase 5.1.1: Public RSVP Backend Implementation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Token Validation",
			"item": [
				{
					"name": "Validate Valid Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token is valid\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.is_valid).to.be.true;",
									"});",
									"",
									"pm.test(\"Response has guest information\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.guest_name).to.be.a('string');",
									"    pm.expect(jsonData.event_name).to.be.a('string');",
									"    pm.expect(jsonData.current_rsvp_status).to.be.a('string');",
									"});",
									"",
									"// Save guest and event IDs for later use",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"guest_id\", jsonData.guest_id);",
									"pm.environment.set(\"event_id\", jsonData.event_id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}{{api_version}}/rsvp/{{valid_token}}/validate",
							"host": ["{{base_url}}"],
							"path": ["{{api_version}}", "rsvp", "{{valid_token}}", "validate"]
						},
						"description": "Validate a valid RSVP token and retrieve basic guest/event information."
					},
					"response": []
				},
				{
					"name": "Validate Invalid Token Format",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token is invalid\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.is_valid).to.be.false;",
									"});",
									"",
									"pm.test(\"Has error message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error_message).to.be.a('string');",
									"    pm.expect(jsonData.error_message.length).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}{{api_version}}/rsvp/invalid/validate",
							"host": ["{{base_url}}"],
							"path": ["{{api_version}}", "rsvp", "invalid", "validate"]
						},
						"description": "Test token validation with an invalid token format (too short)."
					},
					"response": []
				},
				{
					"name": "Validate Non-Existent Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token is invalid\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.is_valid).to.be.false;",
									"});",
									"",
									"pm.test(\"Error indicates token not found\", function () {",
									"    var jsonData = pm.response.json();",
