              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"phone\": \"+1234567890\",\n  \"plus_one_allowed\": true,\n  \"dietary_restrictions\": \"Vegetarian\",\n  \"notes\": \"VIP guest\"\n}"
