              "raw": "{{base_url}}/api/{{api_version}}/events/{{event_id}}/guests/{{guest_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "events", "{{event_id}}", "guests", "{{guest_id}}"]
            },
            "description": "Delete a guest"
          }
        }
