    {
      "name": "5. Bulk Operations",
      "item": [
        {
          "name": "Create Bulk Guests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"All guests created\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "    pm.expect(response.length).to.eql(3);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    const guestIds = response.map(g => g.id);",
                  "    pm.collectionVariables.set(\"bulk_guest_ids\", JSON.stringify(guestIds));",
                  "    console.log(\"Bulk guest IDs saved:\", guestIds);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"email\": \"alice@example.com\",\n    \"first_name\": \"Alice\",\n    \"last_name\": \"Smith\",\n    \"plus_one_allowed\": false\n  },\n  {\n    \"email\": \"bob@example.com\",\n    \"first_name\": \"Bob\",\n    \"last_name\": \"Jones\",\n    \"plus_one_allowed\": true\n  },\n  {\n    \"email\": \"charlie@example.com\",\n    \"first_name\": \"Charlie\",\n    \"last_name\": \"Adams\",\n    \"dietary_restrictions\": \"Gluten-free\",\n    \"plus_one_allowed\": false\n  }\n]"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/events/{{event_id}}/guests/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "events", "{{event_id}}", "guests", "bulk"]
            },
            "description": "Create multiple guests in a single request"
          }
        },
        {
          "name": "Bulk Update Guest Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Bulk update successful\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('updated_count');",
                  "    pm.expect(response).to.have.property('new_status');",
                  "    pm.expect(response.new_status).to.eql('attending');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_ids\": [\"guest-id-1\", \"guest-id-2\", \"guest-id-3\"],\n  \"rsvp_status\": \"attending\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/events/{{event_id}}/guests/bulk-update",
              "host": ["{{base_url}}"],
