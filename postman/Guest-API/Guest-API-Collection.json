{
  "info": {
    "name": "Party-Time Guest API - Phase 4.1.1",
    "_postman_id": "guest-api-collection-v1",
    "description": "Comprehensive test collection for Guest Management API endpoints including CRUD operations, search, sorting, filtering, and bulk operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_version",
      "value": "v1",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "guest_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "rsvp_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Setup & Authentication",
      "item": [
        {
          "name": "Login (Get Auth Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set(\"auth_token\", response.access_token);",
                  "    console.log(\"Auth token saved:\", response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-email@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "auth", "login"]
            },
            "description": "Authenticate and get a JWT token for subsequent requests"
          }
        },
        {
          "name": "Create Test Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Event created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set(\"event_id\", response.id);",
                  "    console.log(\"Event ID saved:\", response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Event for Guests\",\n  \"description\": \"Testing guest management features\",\n  \"type\": \"birthday\",\n  \"start_date\": \"2024-12-15T18:00:00\",\n  \"end_date\": \"2024-12-15T22:00:00\",\n  \"location\": \"123 Party Street\",\n  \"venue_name\": \"Party Hall\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/events",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "events"]
            },
            "description": "Create a test event to associate guests with"
          }
        }
      ],
      "description": "Setup requests to authenticate and create test data"
    },
    {
      "name": "2. CRUD Operations",
      "item": [
        {
          "name": "Create Guest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has guest data\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('email');",
                  "    pm.expect(response).to.have.property('first_name');",
                  "    pm.expect(response).to.have.property('last_name');",
                  "    pm.expect(response).to.have.property('rsvp_status');",
                  "    pm.expect(response.rsvp_status).to.eql('pending');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set(\"guest_id\", response.id);",
                  "    console.log(\"Guest ID saved:\", response.id);",
                  "}"
