            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"weak-password@example.com\",\n    \"password\": \"weak\",\n    \"name\": \"Weak Password User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_version}}/auth/register",
              "host": ["{{base_url}}{{api_version}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Email (Invalid Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid verification code fails', function () {",
