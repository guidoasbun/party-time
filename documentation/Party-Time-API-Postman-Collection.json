          "response": []
        },
        {
          "name": "Resend Verification Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification code resent successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates code resent', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('resent');",
