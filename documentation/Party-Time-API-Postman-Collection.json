    {
      "name": "Password Reset",
      "item": [
        {
          "name": "Request Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: This may fail for unconfirmed users",
                  "pm.test('Password reset request processed', function () {",
                  "    // Should be 200 for confirmed users, 400 for unconfirmed",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Success message returned', function () {",
                  "        const jsonData = pm.response.json();",
                  "        pm.expect(jsonData.message).to.include('reset');",
                  "    });",
                  "} else {",
                  "    pm.test('Error message for unconfirmed user', function () {",
                  "        const jsonData = pm.response.json();",
                  "        pm.expect(jsonData.detail).to.include('not confirmed');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_version}}/auth/password-reset",
              "host": ["{{base_url}}{{api_version}}"],
              "path": ["auth", "password-reset"]
            }
          },
          "response": []
        },
        {
          "name": "Confirm Password Reset (Invalid Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid reset code fails', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message for invalid reset code', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.detail).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"confirmation_code\": \"123456\",\n    \"new_password\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_version}}/auth/password-reset-confirm",
              "host": ["{{base_url}}{{api_version}}"],
              "path": ["auth", "password-reset-confirm"]
            }
          },
          "response": []
        }
      ]
